  "narrative": {
    "northStar": "掌心里的系统时刻",
    "overview": "今刻是一件安静、迅速、可信的个人工具。日视图维持稳定的空间记忆，周/月只以临时检视层出现。视觉惊喜来自精确层级、形变和触感，不来自装饰。",
    "keyCharacteristics": ["430 × 956 普通手机与 860 × 956 展开屏同步预览", "展开屏双栏信息架构", "日视图优先", "中央语音入口", "150–260ms 系统级动效", "44px 以上触控目标"],
    "rules": [
      { "name": "The One Signal Rule", "body": "Signal Vermilion 在任一屏幕的占比不得超过 10%。", "section": "colors" },
      { "name": "The Warm Neutral Rule", "body": "禁止使用纯黑或纯白。", "section": "colors" },
      { "name": "The Native Voice Rule", "body": "所有按钮、标签和数据使用同一系统字体栈。", "section": "typography" },
      { "name": "The Soft Arrival Rule", "body": "新状态以 0.96→1 缩放和淡入出现，150–260ms 完成。", "section": "elevation" },
      { "name": "The Flat-at-Rest Rule", "body": "日程列表和普通内容静止时无阴影。", "section": "elevation" }
    ],
    "dos": ["Do 让今天成为默认答案。", "Do 使用 20px 水平边距和 44px 最小触控区。", "Do 使用支持 reduced-motion 的系统级动效。"],
    "donts": ["Don't 做传统日历的密集网格首页。", "Don't 制造多层级、标签堆叠和卡片海洋。", "Don't 使用夸张插画、霓虹渐变、玻璃拟态或装饰性动效。", "Don't 让周视图和月视图抢走今天。"]
